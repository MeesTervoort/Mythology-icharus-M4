    - target: {fileID: 8166210344723503398, guid: a6b7a812b2f3eb44ab6433ee503c138e, type: 3}
      propertyPath: 'dialogueWords.Array.data[6]'
      value: Well that will be no problem.
      objectReference: {fileID: 0}
    - target: {fileID: 8166210344723503398, guid: a6b7a812b2f3eb44ab6433ee503c138e, type: 3}
      propertyPath: 'dialogueWords.Array.data[7]'
      value: All i need is my feathers and i'll be out.
      objectReference: {fileID: 0}
